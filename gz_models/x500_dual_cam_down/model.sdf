<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <!-- x500 + downward RGB camera (same as x500_mono_cam_down) + downward thermal camera -->
  <model name='x500_dual_cam_down'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://mono_cam</uri>
      <pose>0 0 .10 0 1.5707 0</pose>
      <name>mono_cam</name>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0 0 0 0 1.5707 0</pose>
    </joint>
    <link name="thermal_link">
      <pose>0.05 0 .10 0 1.5707 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="thermal_housing">
        <geometry><box><size>0.02 0.03 0.03</size></box></geometry>
      </visual>
      <sensor name="thermal" type="thermal">
        <gz_frame_id>thermal_link</gz_frame_id>
        <camera>
          <horizontal_fov>0.96</horizontal_fov>   <!-- 55°, same as the MLX90640 D55 desk camera -->
          <image>
            <width>320</width>
            <height>256</height>
            <format>L16</format>
          </image>
          <clip><near>0.1</near><far>200</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>9</update_rate>
        <visualize>true</visualize>
        <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
          <min_temp>253.15</min_temp>
          <max_temp>373.15</max_temp>
          <resolution>0.01</resolution>
        </plugin>
      </sensor>
    </link>
    <joint name="ThermalJoint" type="fixed">
      <parent>base_link</parent>
      <child>thermal_link</child>
    </joint>
  </model>
</sdf>
